# Database — leave unset to use embedded PGlite in ./.data/pglite
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mathmap

# Supabase (optional — enables sign-in, mastery sync, owned documents)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Anthropic (optional — enables the AI document-analysis method server-wide;
# keyword matching works without it, and users can paste their own key in the UI)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
