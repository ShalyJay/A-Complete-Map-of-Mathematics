# Optional: Anthropic key for the AI document-analysis method server-wide.
# Local NLP works without it; you can also paste a key in the upload UI.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional hosted Postgres (skips PGlite / static graph). Seed with ingest scripts.
# DATABASE_URL=postgresql://...

# Force reading data/static-graph.json instead of PGlite (Vercel sets this path via VERCEL=1).
# USE_STATIC_GRAPH=1
