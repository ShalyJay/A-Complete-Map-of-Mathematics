# Optional: Anthropic key for the AI document-analysis method server-wide.
# Local NLP works without it; you can also paste a key in the upload UI.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Where `npm run sync:vault` finds the Personal Wiki vault (default: ../Personal Wiki).
# VAULT_DIR=/path/to/Personal Wiki
